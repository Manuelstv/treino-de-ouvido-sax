rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada jogador tem um documento com o próprio id de login.
    // Quem está logado lê o ranking; cada um só grava o próprio documento.
    match /jogadores/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'acertos', 'melhores', 'atualizado'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 80;
    }

    // Qualquer pessoa, mesmo sem login, pode mandar uma sugestão.
    // Ninguém lê, muda ou apaga sugestões pelo app: só o dono, pelo console.
    match /sugestoes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'sugestao', 'instrumento', 'criada'])
        && request.resource.data.sugestao is string
        && request.resource.data.sugestao.size() > 0
        && request.resource.data.sugestao.size() <= 2000
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 80
        && request.resource.data.instrumento is string
        && request.resource.data.instrumento.size() <= 20
        && request.resource.data.criada == request.time;
    }
  }
}
