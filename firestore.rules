rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada jogador tem um documento com o próprio id de login.
    // Quem está logado lê o ranking; cada um só grava o próprio documento.
    match /jogadores/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'acertos', 'melhores', 'atualizado'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 80;
    }
  }
}
